  "panels": [
    {
      "id": 1,
      "title": "Log Stream Volume by Service",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-ds"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-ds"
          },
          "editorMode": "code",
          "expr": "sum by (service_name, job) (count_over_time({exporter=\"OTLP\"}[1m]))",
          "legendFormat": "{{service_name}} ({{job}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Warning & Error Log Rate",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-ds"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          },
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-ds"
          },
          "editorMode": "code",
          "expr": "sum by (service_name, job) (count_over_time({exporter=\"OTLP\"} |~ \"(?i)(warning|error|exception)\" [1m]))",
          "legendFormat": "{{service_name}} Warn/Error",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Database & Persistence Anomaly Logs",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-ds"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-ds"
          },
          "editorMode": "code",
          "expr": "sum by (job) (count_over_time({job=~\".*mysql.*|.*persistence.*\"} |~ \"(?i)(error|fail|timeout|deadlock)\" [1m]))",
          "legendFormat": "{{job}} anomaly",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Centralized Multi-Cloud Live Logs Stream (AWS & Azure)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-ds"
          },
          "editorMode": "code",
          "expr": "{exporter=\"OTLP\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Database & Persistence Layer Diagnostic Log Stream",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-ds"
          },
          "editorMode": "code",
          "expr": "{job=~\".*mysql.*|.*persistence.*\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Trace Spans Latency Distribution & Service Bottlenecks (P99, P90, P50)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(traces_spanmetrics_latency_bucket[5m]))) * 1000",
          "legendFormat": "{{service_name}} P99",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.90, sum by (le, service_name) (rate(traces_spanmetrics_latency_bucket[5m]))) * 1000",
          "legendFormat": "{{service_name}} P90",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(traces_spanmetrics_latency_bucket[5m]))) * 1000",
          "legendFormat": "{{service_name}} P50",
          "refId": "C"
        }
      ]
    }
  ],
