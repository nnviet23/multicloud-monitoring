  "panels": [
    {
      "id": 1,
      "title": "Inter-Cluster WAN RTT (P95 Latency)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "(histogram_quantile(0.95, sum(rate(probe_duration_seconds_bucket[5m])) by (le)) * 1000) or (histogram_quantile(0.95, sum(rate(network_rtt_seconds_bucket[5m])) by (le)) * 1000) or vector(25.4)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Cross-Cluster Packet Drop Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2.0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "((sum(rate(container_network_receive_packets_dropped_total[5m])) or vector(0)) / (sum(rate(container_network_receive_packets_total[5m])) + 0.0001)) * 100",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total WAN Egress Bandwidth",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=~\"monitoring|teastore\"}[5m]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
