  "panels": [
    {
      "id": 1,
      "title": "Service Graph Total QPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_service_graph_request_total[5m]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Service Graph Failed QPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_service_graph_request_failed_total[5m])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Service Graph Error Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 5.0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "((sum(rate(traces_service_graph_request_failed_total[5m])) or vector(0)) / (sum(rate(traces_service_graph_request_total[5m])) + 0.0001)) * 100",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Inter-Service Edges",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "count(count by (client, server) (traces_service_graph_request_total))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cross-Cluster Service Call Rate by Edge (Client -> Server)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total[5m]))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cross-Cluster Service Call Latency P95 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_server_seconds_bucket[5m]))) * 1000",
          "legendFormat": "{{client}} -> {{server}} P95",
          "refId": "A"
        }
      ]
    },
    {
