      "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "clamp_max(100 - (sum(rate(traces_service_graph_request_failed_total[5m])) / (sum(rate(traces_service_graph_request_total[5m])) + 0.0001) * 100), 100)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 99.0 }, { "color": "green", "value": 99.5 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Remaining Error Budget",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "clamp_min(100 - ((sum(rate(traces_service_graph_request_failed_total[1h])) / (sum(rate(traces_service_graph_request_total[1h])) + 0.0001)) / 0.005 * 100), 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 20.0 }, { "color": "green", "value": 75.0 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Error Budget Burn Rate (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "(sum(rate(traces_service_graph_request_failed_total[1h])) / (sum(rate(traces_service_graph_request_total[1h])) + 0.0001)) / 0.005",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1.0 }, { "color": "red", "value": 2.0 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Multi-Window Error Budget Burn Rate Trend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "(sum(rate(traces_service_graph_request_failed_total[5m])) / (sum(rate(traces_service_graph_request_total[5m])) + 0.0001)) / 0.005",
          "legendFormat": "Burn Rate (5m short window)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "(sum(rate(traces_service_graph_request_failed_total[30m])) / (sum(rate(traces_service_graph_request_total[30m])) + 0.0001)) / 0.005",
          "legendFormat": "Burn Rate (30m medium window)",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Service Error Budget Consumption Breakdown",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "sum by (server) (rate(traces_service_graph_request_failed_total{server=~\"$service\"}[5m]))",
          "legendFormat": "{{server}} Errors/sec",
          "range": true,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Investigate Error Traces & Logs (${__field.name})",
          "url": "/d/mc-logs-traces-deepdive?var-service=${__field.name}&var-cluster=${cluster}&from=${__from}&to=${__to}",
          "targetBlank": true
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2 }, "unit": "reqps" }
      }
    }
