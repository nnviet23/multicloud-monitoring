          "editorMode": "code",
          "expr": "label_replace(label_join(label_replace(label_replace(sum by (client, server) (rate(traces_service_graph_request_total{server!=\"unknown\"}[5m])) > 0, \"source\", \"$1\", \"client\", \"(.*)\"), \"target\", \"$1\", \"server\", \"(.*)\"), \"id\", \"->\", \"client\", \"server\"), \"mainStat\", \"Active (mTLS 1.3)\", \"id\", \"(.*)\")",
