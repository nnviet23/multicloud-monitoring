          "editorMode": "code",
          "expr": "sum by (client, server, client_cloud_region, server_cloud_region) (rate(traces_service_graph_request_total{server!=\"unknown\"}[1m]))",
          "legendFormat": "{{client}} ({{client_cloud_region}}) -> {{server}} ({{server_cloud_region}})",
          "range": true,
          "refId": "A"
        }
      ]
