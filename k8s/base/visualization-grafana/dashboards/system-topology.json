      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name) (system_cpu_load_average_1m)",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "(sum by (k8s_cluster_name) (system_memory_usage_bytes{state=\"used\"}) / sum by (k8s_cluster_name) (system_memory_usage_bytes)) * 100",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name) (rate(system_network_dropped_total[1m]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
