          "legendFormat": "{{k8s_cluster_name}} Load 5m",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "system_cpu_load_average_15m{k8s_cluster_name=~\"$cluster\"}",
          "legendFormat": "{{k8s_cluster_name}} Load 15m",
          "range": true,
