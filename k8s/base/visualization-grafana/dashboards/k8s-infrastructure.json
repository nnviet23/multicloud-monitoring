        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "count by (k8s_cluster_name) (count by (k8s_cluster_name, cpu) (system_cpu_time_seconds_total{k8s_cluster_name=~\"$cluster\"}))",
          "legendFormat": "{{k8s_cluster_name}} CPU Cores",
          "range": true,
          "refId": "D"
