      "id": 1,
      "title": "Panel 1: CPU Utilization Breakdown (User vs System vs Idle vs Wait)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name, state) (rate(system_cpu_time_seconds_total{k8s_cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "{{k8s_cluster_name}} ({{state}})",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "id": 2,
      "title": "Panel 2: CPU I/O Wait (%wa) & Steal Saturation Alert",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "(sum by (k8s_cluster_name) (rate(system_cpu_time_seconds_total{k8s_cluster_name=~\"$cluster\", state=\"wait\"}[1m])) / (sum by (k8s_cluster_name) (rate(system_cpu_time_seconds_total{k8s_cluster_name=~\"$cluster\"}[1m])) + 0.0001)) * 100",
          "legendFormat": "{{k8s_cluster_name}} - I/O Wait (%wa)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "(sum by (k8s_cluster_name) (rate(system_cpu_time_seconds_total{k8s_cluster_name=~\"$cluster\", state=\"steal\"}[1m])) / (sum by (k8s_cluster_name) (rate(system_cpu_time_seconds_total{k8s_cluster_name=~\"$cluster\"}[1m])) + 0.0001)) * 100",
          "legendFormat": "{{k8s_cluster_name}} - Steal Time (%st)",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        }
      }
    },
