        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (job) (count_over_time({exporter=\"OTLP\"} |~ \"(?i)(aborted|timeout|refused|oom|killed|io|error|fail|slow)\" [1m]))",
