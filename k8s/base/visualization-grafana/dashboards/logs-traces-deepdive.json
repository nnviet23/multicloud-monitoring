  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Log Stream Volume by Service",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (job) (count_over_time({exporter=\"OTLP\"}[1m]))",
          "legendFormat": "Service: {{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2 }, "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Warning & Error Log Rate",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (job) (count_over_time({exporter=\"OTLP\"} |~ \"(?i)(warning|error|exception)\" [1m]))",
          "legendFormat": "{{job}} Warn/Error",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" }, "custom": { "lineWidth": 2 }, "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "id": 3,
      "title": "Infrastructure, Database & Connection Anomaly Logs Count",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (job) (count_over_time({exporter=\"OTLP\"} |~ \"(?i)(aborted|timeout|refused|oom|killed|io|error|fail|slow)\" [1m]))",
          "legendFormat": "Anomaly: {{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "custom": { "lineWidth": 2 }, "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "id": 4,
      "title": "Centralized Multi-Cloud Live Logs Stream (AWS & Azure)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "{exporter=\"OTLP\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "id": 5,
      "title": "Database & Persistence Layer Diagnostic Log Stream (Azure Data Services)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "{exporter=\"OTLP\"} |~ \"(?i)(persistence|mysql|mariadb|innodb|deadlock|lock|db|teadb)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "id": 6,
      "title": "Tempo Distributed TraceQL Explorer (Cross-Cloud Slow & Error Traces)",
      "description": "Truy vấn TraceQL thời gian thực từ Tempo backend: Lọc toàn bộ các Trace spans có lỗi (status=error) hoặc thời gian phản hồi vượt ngưỡng WAN/DB (> 1.5s). Click vào từng Trace ID để xem Waterfall Spans chi tiết.",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo-ds" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo-ds" },
          "queryType": "traceql",
          "query": "{ status = error || duration > 1.5s }",
          "limit": 25,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "id": 7,
      "title": "Trace Spans Latency Distribution & Service Bottlenecks (P99, P90, P50)",
      "description": "Phân phối độ trễ microservices từ service graph bucket metrics, phát hiện nghẽn mạng WAN và suy giảm hiệu năng cơ sở dữ liệu MySQL.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, server) (rate(traces_service_graph_request_server_seconds_bucket{server=~\"$service\"}[5m]))) * 1000",
          "legendFormat": "P99 - {{server}} (ms)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.90, sum by (le, server) (rate(traces_service_graph_request_server_seconds_bucket{server=~\"$service\"}[5m]))) * 1000",
          "legendFormat": "P90 - {{server}} (ms)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "thanos-query-ds" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, server) (rate(traces_service_graph_request_server_seconds_bucket{server=~\"$service\"}[5m]))) * 1000",
          "legendFormat": "P50 - {{server}} (ms)",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "ms"
        }
      }
    }
  ],
