      "id": 4,
      "title": "Cross-Cloud WAN Calls / sec",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_service_graph_request_total{client_cloud_provider!=server_cloud_provider}[1m])) or sum(rate(traces_service_graph_request_total{server=~\"teadb|teastore-registry\"}[1m]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "unit": "reqps",
          "decimals": 2
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "title": "Cross-Cloud Network Latency Duration (AWS -> Azure)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_server_seconds_bucket{client_cloud_provider!=server_cloud_provider}[5m]) or rate(traces_service_graph_request_server_seconds_bucket{server=~\"teadb|teastore-registry\"}[5m]))) * 1000",
          "legendFormat": "{{client}} (AWS) -> {{server}} (Azure) [P95]",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, client, server) (rate(traces_service_graph_request_server_seconds_bucket{client_cloud_provider!=server_cloud_provider}[5m]) or rate(traces_service_graph_request_server_seconds_bucket{server=~\"teadb|teastore-registry\"}[5m]))) * 1000",
          "legendFormat": "{{client}} (AWS) -> {{server}} (Azure) [P50]",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "title": "WAN Bridge Network I/O Throughput (mc-monitoring-net)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name, direction) (rate(system_network_io_bytes_total{k8s_cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "{{k8s_cluster_name}} - {{direction}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "Bps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "title": "Actual Network Packet Drops & Transmission Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name, direction) (rate(system_network_dropped_total{k8s_cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "{{k8s_cluster_name}} Drops ({{direction}})",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name, direction) (rate(system_network_errors_total{k8s_cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "{{k8s_cluster_name}} Errors ({{direction}})",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 8,
      "title": "Cross-Cluster Packet Rates & TCP Socket Saturation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos-query-ds"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name, direction) (rate(system_network_packets_total{k8s_cluster_name=~\"$cluster\"}[1m]))",
          "legendFormat": "{{k8s_cluster_name}} Packets ({{direction}})",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos-query-ds"
          },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name, state) (system_network_connections{k8s_cluster_name=~\"$cluster\", state=~\"ESTABLISHED|TIME_WAIT|CLOSE_WAIT\"})",
          "legendFormat": "{{k8s_cluster_name}} Sockets ({{state}})",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "unit": "short"
        }
      }
    }
  ],
