  "cards": [
    {
      "dot": "cyan",
      "title": "Control Plane & Gatekeeper Standards (SPEC-0005, SPEC-0008)",
      "items": [
        "Makefile provides strict gatekeepers (validate-otel, diagrams, lint) before deployment",
        "Ansible automates 3 k3d clusters, WAN impairment (tc netem), and mTLS secret distribution",
        "Argo CD ApplicationSets manage automated reconciliation (selfHeal: true, prune: true)"
      ]
    },
    {
      "dot": "rose",
      "title": "Cross-Cloud Network & Ingestion (ADR-0013, SPEC-0007)",
      "items": [
        "Spoke Edge Collectors drop noise at source before WAN transport (ADR-0013)",
        "Spoke-to-Hub transport protected by Native mTLS 1.3 over hub-gateway.hub.multicloud.local:4317",
        "Hub Gateway evaluates servicegraph connector before tail-based sampling (ADR-0014)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Storage & Closed-Loop AIOps (ADR-0016, SPEC-0010)",
      "items": [
        "MinIO stores immutable blocks from Thanos, Loki, Tempo; raw telemetry direct-write removed (ADR-0016)",
        "Grafana dynamically provisions dashboards via kiwigrid/k8s-sidecar watching ConfigMaps",
        "Pyrra tracks SLO Error Budgets; Robusta enriches alerts and drives closed-loop remediation"
      ]
    }
